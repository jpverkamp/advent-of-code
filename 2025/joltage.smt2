(set-option :produce-models true)
(set-logic QF_LIA)
(declare-const p0 Int)
(assert (>= p0 0))
(declare-const p1 Int)
(assert (>= p1 0))
(declare-const p2 Int)
(assert (>= p2 0))
(declare-const p3 Int)
(assert (>= p3 0))
(declare-const p4 Int)
(assert (>= p4 0))
(declare-const p5 Int)
(assert (>= p5 0))
(assert (= (+ p0 p1 p2) 10))
(assert (= (+ p0 p2 p3) 11))
(assert (= (+ p0 p2 p3) 11))
(assert (= (+ p0 p1) 5))
(assert (= (+ p0 p1 p2) 10))
(assert (= (+ p2) 5))
(minimize (+ p0 p1 p2 p3 p4 p5))
(check-sat)
(get-model)
